@startuml

left to right direction

package "Клиент (Browser)" {
  [React/Vanilla JS Frontend] as Frontend
  [Web Crypto API] as Crypto
  [Local Storage] as Storage
}

package "Шлюз (Gateway)" {
  [HTTPS/REST] as API
}

package "Сервер (Spring Boot)" {
  package "Слой представления (Web)" {
    [AuthController] as AuthController
    [VaultController] as VaultController
    [UserController] as UserController
  }

  package "Слой безопасности (Security)" {
    [JwtAuthenticationFilter] as JwtFilter
    [CustomAuthenticationProvider] as AuthProvider
    [PepperService] as PepperService
  }

  package "Слой приложения (Application)" {
    [AuthService] as AuthService
    [VaultService] as VaultService
    [UserService] as UserService
  }

  package "Слой данных (Data)" {
    [UserRepository] as UserRepo
    [AuditLogRepository] as AuditRepo
  }
}

package "Внешние системы" {
  [PostgreSQL Database] as DB
  [Redis (Rate limiting)] as Redis
  [Email Service] as Email
}

Frontend --> Crypto : Генерация ключей\nШифрование/Расшифровка
Frontend --> Storage : Хранение сессии
Frontend --> API : HTTPS запросы

API --> AuthController : /api/auth/*
API --> VaultController : /api/vault/*

AuthController --> JwtFilter : Аутентификация
AuthController --> AuthService : Бизнес-логика

VaultController --> JwtFilter : Проверка JWT
VaultController --> VaultService : Бизнес-логика

AuthService --> UserService : Управление пользователями
AuthService --> PepperService : Добавление перца

UserService --> UserRepo : CRUD операции
VaultService --> UserRepo : Доступ к vault

UserRepo --> DB : Сохранение
AuthService --> Redis : Rate limiting
AuthService --> Email : Уведомления

@enduml