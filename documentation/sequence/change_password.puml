@startuml

actor User as "Пользователь"
participant Browser as "Браузер (JS)"
participant "Web Crypto" as Crypto
participant "Spring Boot" as Server
participant "PepperService" as Pepper
participant "DB" as Database

User -> Browser: Вводит:\n- старый мастер-пароль\n- новый мастер-пароль
activate Browser

Browser -> Crypto: Расшифровать vault старым ключом
activate Crypto
Crypto --> Browser: decryptedVault
deactivate Crypto

Browser -> Crypto: Сгенерировать новый clientSalt (опционально)
Browser -> Crypto: PBKDF2(новый мастер-пароль + clientSalt)
activate Crypto
Crypto --> Browser: newEncryptionKey
deactivate Crypto

Browser -> Crypto: AES-256-GCM.encrypt(newEncryptionKey, decryptedVault)
activate Crypto
Crypto --> Browser: newEncryptedVault
deactivate Crypto

Browser -> Server: POST /api/auth/change-password (with JWT)\n{newMasterPassword, newEncryptedVault}
activate Server

Server -> Server: Генерировать новый serverSalt
Server -> Pepper: Получить serverPepper
activate Pepper
Pepper --> Server: serverPepper
deactivate Pepper

Server -> Server: combine = newMasterPassword + newServerSalt + serverPepper
Server -> Server: newAuthHash = BCrypt(combine)

Server -> Database: UPDATE users SET\nserverSalt = ?, authHash = ?, encryptedVault = ?
activate Database
Database --> Server: OK
deactivate Database

Server --> Browser: 200 OK
deactivate Server

Browser --> User: "Пароль успешно изменен"
deactivate Browser
@enduml