@startuml

actor User as "Пользователь"
participant Browser as "Браузер (JS)"
participant "Web Crypto" as Crypto
participant "Spring Boot" as Server
participant "AuthProvider" as Auth
participant "PepperService" as Pepper
participant "DB" as Database
participant "JWT" as Token

User -> Browser: Вводит:\n- username\n- masterPassword
activate Browser

Browser -> Server: GET /api/auth/salt/{username}
activate Server
Server -> Database: SELECT serverSalt FROM users WHERE username=?
activate Database
Database --> Server: serverSalt
deactivate Database
Server --> Browser: {salt: serverSalt}
deactivate Server

Browser -> Crypto: Получить clientSalt из localStorage
activate Crypto
Crypto --> Browser: clientSalt
deactivate Crypto

Browser -> Crypto: PBKDF2(masterPassword + clientSalt)\n(для расшифровки vault)
activate Crypto
Crypto --> Browser: decryptionKey
deactivate Crypto
note right: Ключ хранится только в памяти,\nне отправляется на сервер

Browser -> Server: POST /login\n{username, masterPassword}
activate Server
Server -> Pepper: Получить serverPepper
activate Pepper
Pepper --> Server: serverPepper
deactivate Pepper

Server -> Auth: authenticate(username, masterPassword, serverPepper)
activate Auth
Auth -> Database: SELECT authHash, serverSalt FROM users
Database --> Auth: authHash, serverSalt
Auth -> Auth: combine = masterPassword + serverSalt + serverPepper
Auth -> Auth: BCrypt.matches(combine, authHash)
Auth --> Server: Authentication object
deactivate Auth

Server -> Token: generate JWT
activate Token
Token --> Server: JWT token
deactivate Token

Server --> Browser: 200 OK + JWT token
deactivate Server

Browser -> Server: GET /api/vault (with JWT)
activate Server
Server -> Database: SELECT encryptedVault FROM users
Database --> Server: encryptedVault
Server --> Browser: encryptedVault
deactivate Server

Browser -> Crypto: AES-256-GCM.decrypt(encryptedVault, decryptionKey)
activate Crypto
Crypto --> Browser: decryptedVault (JSON с паролями)
deactivate Crypto

Browser --> User: Отображает список паролей
deactivate Browser
@enduml